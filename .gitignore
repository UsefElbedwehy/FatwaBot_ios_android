# macOS
.DS_Store

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.p8
*.keystore
google-services.json
GoogleService-Info.plist

# Node / dashboard
node_modules/
dashboard/.next/
dashboard/out/
*.tsbuildinfo

# iOS / Swift
ios/**/.build/
ios/**/xcuserdata/
ios/**/*.xcresult
ios/**/DerivedData/
.swiftpm/

# Android
android/**/build/
android/.gradle/
android/.kotlin/
android/local.properties
android/**/*.iml

# Supabase local
backend/supabase/.temp/
backend/supabase/.branches/
# Supabase CLI writes local state wherever it's invoked from — ignore anywhere.
**/supabase/.temp/
**/supabase/.branches/

# Test / coverage artifacts
coverage/
*.lcov

# XcodeGen output (regenerate: cd ios/App && xcodegen generate)
ios/App/FatwaBot.xcodeproj/

# Generated hadith/content import SQL (regenerate via scripts/hadith_import.ts)
backend/supabase/imports/
