<?xml version="1.0" encoding="utf-8"?>
<!-- Supported per-app languages (Android 13+ shows the native Language picker in
     App info when this is declared via android:localeConfig). Arabic-first. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="ar" />
    <locale android:name="en" />
</locale-config>
