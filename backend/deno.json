{
  "tasks": {
    "test": "deno test tests/",
    "lint": "deno lint functions/ tests/",
    "fmt": "deno fmt --check functions/ tests/"
  },
  "fmt": {
    "lineWidth": 110,
    "indentWidth": 2
  },
  "lint": {
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  },
  "compilerOptions": {
    "strict": true
  }
}
